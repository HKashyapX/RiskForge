[TEMPLATE]
# RiskForge frontend environment
#
# VITE_API_MODE     "live" to read from the RiskForge FastAPI backend, "demo" for
#                   the baked demo dataset (default when no base URL is set).
# VITE_API_BASE_URL Backend origin, e.g. http://127.0.0.1:8000. Implies live mode.
#
# SECURITY: there is deliberately NO token variable here.  Vite inlines all
# VITE_* values into the client bundle, so any credential placed in this file
# would ship to every browser.  For pilot/production, obtain a short-lived
# token from your identity provider at runtime and register it through
# setAuthToken() (src/api/adapters/live/apiClient.ts) from the host app or a
# login step.  The backend's CORS policy must allow the frontend origin.
#
# Copy to .env.local and adjust for your environment.
VITE_API_MODE=live
VITE_API_BASE_URL=http://127.0.0.1:8000
