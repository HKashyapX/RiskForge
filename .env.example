[TEMPLATE]
# ── PostgreSQL ──
PGHOST=localhost
PGPORT=5432
PGDATABASE=riskforge
PGUSER=postgres
PGPASSWORD=CHANGE_ME_IN_PRODUCTION
PGCONNECT_TIMEOUT=10
# TLS mode for PostgreSQL connections: disable|allow|prefer|require|verify-ca|verify-full
PGSSLMODE=prefer
PGMINPOOL=1
PGMAXPOOL=5
# Seconds to wait for a pooled connection before failing
PGPOOL_TIMEOUT=30
# Optional per-statement timeout in milliseconds (unset = disabled)
# PGSTATEMENT_TIMEOUT_MS=5000

# ── Persistence backend ──
# sqlite (default) | postgres
RISKFORGE_PERSISTENCE=sqlite
# SQLite database file (sqlite backend only)
RISKFORGE_SQLITE_PATH=data/riskforge.db
# Review authorization policy (currently: allow_all)
RISKFORGE_REVIEW_AUTHORIZATION=allow_all

# ── API Server ──
# Set only for the explicitly non-inferencing presentation service.
# RISKFORGE_MODE=demo
RISKFORGE_ENV=development
RISKFORGE_LOG_LEVEL=INFO
RISKFORGE_API_HOST=0.0.0.0
RISKFORGE_API_PORT=8000

# ── CORS (comma-separated origins, or * for dev) ──
RISKFORGE_CORS_ORIGINS=*

# ── Authentication ──
# Set to any value to enable auth on protected routes
# RISKFORGE_AUTH_ENABLED=true
# RISKFORGE_AUTH_ISSUER=riskforge
# RISKFORGE_AUTH_AUDIENCE=riskforge-api
# RISKFORGE_AUTH_KEYS_DIR=/etc/riskforge/auth-keys
# RISKFORGE_AUTH_LEEWAY_SECONDS=0

# ── ML Serving ──
# When both paths are set, the real ONNX model is used. When neither is set,
# the deterministic heuristic rule engine is used (surfaced via /ready).
# RISKFORGE_MODEL_PATH=/data/models/sif_int8.onnx
# RISKFORGE_MANIFEST_PATH=/data/models/manifest.yaml
# RISKFORGE_MAX_BATCH_SIZE=32
# RISKFORGE_INFERENCE_TIMEOUT_S=30

# ── Grafana (for monitoring profile) ──
# GF_SECURITY_ADMIN_PASSWORD=admin
