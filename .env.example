# RiskForge environment template.
#
# Copy to `.env` and provision REAL values. Nothing here has a safe default:
# the compose file refuses to start while required variables are unset.
# Never commit the populated .env.

# ── Deployment mode (REQUIRED) ──────────────────────────────────────
# demo | pilot | production  (see docs/decisions/0006-deployment-modes.md)
RISKFORGE_DEPLOYMENT_MODE=pilot

# ── PostgreSQL ──────────────────────────────────────────────────────
PGHOST=postgres
PGPORT=5432
PGDATABASE=riskforge
# Provision per environment; no defaults are shipped.
PGUSER=
PGPASSWORD=
PGCONNECT_TIMEOUT=10
# TLS mode for PostgreSQL connections: disable|allow|prefer|require|verify-ca|verify-full
PGSSLMODE=prefer
PGMINPOOL=1
PGMAXPOOL=5
PGPOOL_TIMEOUT=30
# Optional per-statement timeout in milliseconds (unset = disabled)
# PGSTATEMENT_TIMEOUT_MS=5000

# ── Persistence backend ─────────────────────────────────────────────
# production REQUIRES postgres; demo/pilot may use sqlite.
RISKFORGE_PERSISTENCE=postgres
# SQLite database file (sqlite backend only)
RISKFORGE_SQLITE_PATH=data/riskforge.db
# Comma-separated subject ids allowed to record review decisions.
# UNSET = every review is denied (fail closed).
# RISKFORGE_REVIEWER_SUBJECTS=alice,bob

# ── API Server ──────────────────────────────────────────────────────
RISKFORGE_ENV=production
RISKFORGE_LOG_LEVEL=INFO
RISKFORGE_API_HOST=0.0.0.0
RISKFORGE_API_PORT=8000

# ── CORS (comma-separated origins; * is rejected in staging/production) ──
RISKFORGE_CORS_ORIGINS=https://dashboard.example-oil.in

# ── Authentication (REQUIRED in pilot/production) ───────────────────
RISKFORGE_AUTH_ENABLED=true
RISKFORGE_AUTH_ISSUER=
RISKFORGE_AUTH_AUDIENCE=
# Directory of <kid>.key files (>= 32 bytes each), mounted read-only.
RISKFORGE_AUTH_KEYS_DIR=
RISKFORGE_AUTH_LEEWAY_SECONDS=0

# ── ML Serving ──────────────────────────────────────────────────────
# REQUIRED in production; optional in pilot. All three must be configured
# together; the tokenizer name must match the manifest backbone.
# RISKFORGE_MODEL_PATH=/data/models/sif.onnx
# RISKFORGE_MANIFEST_PATH=/data/models/manifest.json
# RISKFORGE_TOKENIZER_NAME=microsoft/deberta-v3-base

# ── Ingestion limits (optional; tighten only — never disabled) ──────
# RISKFORGE_INGEST_LIMIT_MAX_BYTES=20971520
# RISKFORGE_INGEST_LIMIT_MAX_RECORDS=5000
# RISKFORGE_INGEST_LIMIT_MAX_PDF_PAGES=200
# RISKFORGE_INGEST_LIMIT_MAX_XLSX_CELLS=5000000

# ── Grafana (monitoring profile; no default password) ───────────────
GF_SECURITY_ADMIN_PASSWORD=
